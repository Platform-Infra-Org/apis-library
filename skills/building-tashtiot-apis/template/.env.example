# Copy to .env for local runs. Never commit .env. Values here are placeholders, not secrets.

# --- App (read by app/global_conf.py) ---
API_TITLE=My API
APP_VERSION=v0.0.0-local
AWX_URL=https://awx.example.internal/
AWX_TOKEN=<awx-token>

# --- DNS module (app/v1/dns/conf.py) ---
# AWX_CREATE_DNS_TEMPLATE_ID=2178

# --- Library: app basics ---
# PORT=8000
# LOG_LEVEL=INFO
# PROXIED=false
# PROXY_LISTEN_PATH=/

# --- Library: inbound auth (enable_auth=True is in code; this switch turns it on) ---
# AUTH_ENABLED=true
# Exactly ONE of:
#   AUTH_OIDC_ISSUER=https://sso.example.internal/realms/platform   # production (JWKS discovery)
#   AUTH_JWKS_URL=https://sso.example.internal/.../certs             # production (explicit JWKS)
#   AUTH_PUBLIC_KEY_PATH=/etc/secrets/jwt_pub.pem                    # offline RS256
#   AUTH_HS256_SECRET=<32+ byte secret>                              # tests / local dev only
# AUTH_AUDIENCE=my-api      # required in production
# AUTH_ISSUER=              # optional extra check

# --- Library: outbound SSO (only if the API calls protected services) ---
# AUTH_SSO_TOKEN_URL=https://sso.example.internal/.../token
# AUTH_SSO_CLIENT_ID=my-api
# AUTH_SSO_CLIENT_SECRET=<client-secret>
# AUTH_SSO_SCOPE=

# --- Remote Config (optional; when CONFIG_API_URL is unset the provider is off) ---
# CONFIG_API_URL=https://config-api.example.internal
# CONFIG_API_REMOTE_PREFIX=/api/v1
# CONFIG_REMOTE_AUTH_METHOD=none    # none | bearer | sso
# CONFIG_REMOTE_BEARER_TOKEN=<token>
# CONFIG_REMOTE_SSO_TOKEN_URL= / CONFIG_REMOTE_SSO_CLIENT_ID= / CONFIG_REMOTE_SSO_CLIENT_SECRET=
